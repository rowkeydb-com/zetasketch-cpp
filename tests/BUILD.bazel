cc_test(
    name = "differential_fuzzer",
    srcs = ["differential_fuzzer_test.cpp"],
    # This target launches the reference hundreds of times: once per
    # configuration and population for the create and merge comparisons,
    # and once for each product driven through it. Under the memory
    # sanitizer on a slow runner that exceeds the default timeout, which
    # is what the declaration below raises.
    timeout = "long",
    data = [":ZetaSketchCli"],
    args = ["--java_cli=tests/ZetaSketchCli"],
    deps = [
        "//:zetasketch-cpp",
        "@googletest//:gtest",
    ],
)

