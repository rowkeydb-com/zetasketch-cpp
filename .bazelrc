# zetasketch-cpp Bazel configuration.
#
# The options shared with rowkeydb, rowkeyraft and limen are in
# bazel/build_infra/shared.bazelrc, a checked copy of
# rowkeydb-com/rowkeydb-build-infra's, imported first: the compilers, the
# C++ standard, the warnings, the options of all code, the sanitizer,
# clang-tidy, coverage and BuildBuddy configurations, and the image every
# action runs in. The lines after it are zetasketch-cpp's own; each is on
# the allowlist that repository keeps for zetasketch-cpp, with its reason,
# and its scripts/check.sh refuses any other.

import %workspace%/bazel/build_infra/shared.bazelrc

# The reference harness and protobuf's Java runtime are compiled and run
# on the hermetic JDK 21 that rules_java downloads, on every host alike.
# Left to the default, the local JDK is taken as the target runtime, and
# a host with a newer JDK than the toolchain's javac cannot compile for
# it. The options are the target's only: the tools Bazel runs keep the
# defaults, as in the other repositories which share the options, whose
# execution configuration, protoc's included, would otherwise differ from
# this one's, and with it every key of the actions built in it.
build --java_language_version=21 --java_runtime_version=remotejdk_21

# clang-tidy combined with the Clang Static Analyzer (path-sensitive checks)
build:clang-tidy-analyzer --config=clang
build:clang-tidy-analyzer --aspects @bazel_clang_tidy//clang_tidy:clang_tidy.bzl%clang_tidy_aspect
build:clang-tidy-analyzer --@bazel_clang_tidy//:clang_tidy_config=//:clang_tidy_analyzer_config
build:clang-tidy-analyzer --output_groups=report

# Coverage: only the library's own top-level package is instrumented.
coverage --instrumentation_filter="^//:"

# A test run under BuildBuddy downloads no test output but the logs Bazel
# needs; the reference comparison's log is downloaded as well, so that
# the runner script can print its seed and digest into the job's log.
test:buildbuddy --remote_download_regex=.*/testlogs/tests/differential_fuzzer/test\.log$
