module(
    name = "zetasketch-cpp",
    version = "0.9.1",
)

# The build infrastructure shared with rowkeydb, rowkeyraft and limen: the
# image every action runs in, the versions of the shared modules and the
# options in bazel/build_infra/shared.bazelrc (rowkeydb's
# design/shared_build_architecture.md). Pinned to the archive of one
# commit, published as an asset of its release; the shared options are
# copied from the same commit. A development dependency, as the design's
# section on the shared Bazel module requires of a library: a consumer of
# zetasketch-cpp need not find the module in any registry.
bazel_dep(name = "rowkeydb_build_infra", version = "0.10.0", dev_dependency = True)
git_override(
    module_name = "rowkeydb_build_infra",
    commit = "1258624cf739f3802383fc4a22300fc3a729d58f",
    remote = "https://github.com/rowkeydb-com/rowkeydb-build-infra.git",
)

# --- Go ---
# Gazelle, whose check of //bazel/gazelle finds no Go here, and so
# requires only that each BUILD file be in the form buildifier gives it.
# rules_go, Gazelle and the Go SDK are at the versions
# rowkeydb_build_infra approves, and like it they are development
# dependencies: the library has no Go, and a consumer of it needs none of
# them. Without Go there is nothing for nogo to check.
bazel_dep(name = "rules_go", version = "0.64.1", dev_dependency = True)
bazel_dep(name = "gazelle", version = "0.54.0", dev_dependency = True)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.download(version = "1.27.3")

# --- clang-tidy ---
git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
git_repository(
    name = "bazel_clang_tidy",
    commit = "496018e020cf0a7d813a2b5a9d246ec55340a7ed",
    remote = "https://github.com/erenon/bazel_clang_tidy.git",
)

# --- Dependencies ---
# rules_cc, protobuf and googletest at the versions rowkeydb_build_infra
# approves, which its scripts/check.sh compares. It approves zlib as well,
# which protobuf brings into the graph, so the graph selects the approved
# version.
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "protobuf", version = "36.2")

# --- Test dependencies ---
# Development dependencies: googletest, and the Java reference
# implementation with its Maven artifacts, which only the tests use. A
# consumer of zetasketch-cpp builds the library alone, and takes none of
# them into its graph.
bazel_dep(name = "googletest", version = "1.18.0", dev_dependency = True)
bazel_dep(name = "rules_jvm_external", version = "6.9", dev_dependency = True)
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven", dev_dependency = True)

# The dependencies of the Java reference implementation, taken from its
# own build definition. The protobuf runtime is pinned to the version
# matching the protobuf module above, so that the generated code and the
# runtime come from one release.
maven.install(
    artifacts = [
        "com.google.auto.value:auto-value:1.11.0",
        "com.google.auto.value:auto-value-annotations:1.11.0",
        "com.google.code.findbugs:jsr305:3.0.2",
        "com.google.errorprone:error_prone_annotations:2.14.0",
        "com.google.guava:guava:33.0.0-jre",
        "com.google.protobuf:protobuf-java:4.36.2",
        "it.unimi.dsi:fastutil:8.2.2",
        "org.checkerframework:checker-qual:3.30.0",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
    # Pinned, so that a build resolves nothing and fetches only what the
    # lock file names; Maven Central has rate-limited the unpinned
    # resolution in CI. Regenerate with `bazel run @maven//:pin`.
    lock_file = "//:maven_install.json",
    # A lock file behind the artifact list fails the build rather than
    # resolving unpinned, which is what the pin is for.
    fail_if_repin_required = True,
)
use_repo(maven, "maven")

# The Java reference implementation, built from source rather than taken
# from Maven. The only published artifact is 0.1.0 from 2019, which
# enforces a minimum normal precision of 10 where this source enforces
# 4, so a differential test against the artifact cannot establish
# compatibility with the library Google actually publishes today.
http_archive(
    name = "zetasketch_java",
    build_file = "//third_party:zetasketch_java.BUILD",
    dev_dependency = True,
    sha256 = "0172dc137146dbb7102c586c42d62e246064dc494a210522a0ae2a6874ae0db4",
    strip_prefix = "zetasketch-d098c49efb5a5bc70eec89c028a38b14b930ca98",
    urls = ["https://github.com/google/zetasketch/archive/d098c49efb5a5bc70eec89c028a38b14b930ca98.tar.gz"],
)
