# clang-format configuration for zetasketch-cpp.
#
# We follow the Google C++ Style Guide as the base. The few overrides
# below are deliberate project conventions.

BasedOnStyle: Google

# Pointer alignment: prefer "int& foo" over "int &foo". The style guide
# only asks for consistency within a project; we choose left-aligned.
DerivePointerAlignment: false
PointerAlignment: Left

# "West const": write "const int&" rather than "int const&". The strict
# C++ reviewer mandates West const compliance.
QualifierAlignment: Left

# Sort and merge #include blocks.
IncludeBlocks: Merge

IncludeCategories:
  # C system headers
  - Regex: '^<[A-Za-z0-9_]*\.h>$'
    Priority: 1
  # C++ standard library headers
  - Regex: '^<[a-z_]+>$'
    Priority: 2
  # Third-party libraries
  - Regex: '^<.*/.*'
    Priority: 3
  # Other quoted includes (e.g. aggregator.pb.h)
  - Regex: '^"[^/]+\.h"'
    Priority: 4
  # Project headers (zetasketch)
  - Regex: '^"zetasketch/'
    Priority: 5
